. {
    prometheus
    errors
    log
    debug
    auto {
        directory . db\.(.*)\.signed {1}
    }
}

quic://.:853 {
    prometheus
    errors
    log
    debug
    tls cert.pem key.pem
    quic {
        max_streams 16
        worker_pool_size 65536
    }
    auto {
        directory . db\.(.*)\.signed {1}
    }
}

tls://.:8853 {
    prometheus
    errors
    log
    debug
    tls cert.pem key.pem
    auto {
        directory . db\.(.*)\.signed {1}
    }
}